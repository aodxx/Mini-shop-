{
  "name": "mini-shop-modern",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @mini-shop/server dev\" \"pnpm --filter @mini-shop/client dev\"",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
